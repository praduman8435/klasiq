// Prisma schema for the school-uniform commerce platform.
// See docs/PHASE_0_AUDIT.md for the architectural reasoning behind this model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UniformGender {
  BOYS
  GIRLS
  UNISEX
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum FulfillmentType {
  STORE_PICKUP
  LOCAL_DELIVERY
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  UPI
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Independent from OrderStatus on purpose — "order confirmed" is not the
/// same fact as "payment completed". COD/pay-at-store orders are created
/// UNPAID and stay that way until staff collect payment. FAILED exists now
/// (unused by the Phase 2 COD-only flow) so a future online-payment
/// integration doesn't need another migration to add it.
enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

/// ACTIVE baskets behave like a normal cart. Once a basket has produced an
/// order it flips to CONVERTED and is never mutated or checked out again —
/// see Basket.convertedOrderId and docs/PHASE_2_REPORT.md ("Basket
/// conversion strategy") for why this replaces deleting/clearing items.
enum BasketStatus {
  ACTIVE
  CONVERTED
}

// ---------------------------------------------------------------------------
// Schools
// ---------------------------------------------------------------------------

/// A participating school. Its public storefront lives at /school/[slug] and
/// is the landing target for that school's printed QR code.
model School {
  id                String  @id @default(cuid())
  slug              String  @unique
  name              String
  logoUrl           String?
  city              String?
  isActive          Boolean @default(true)
  isDemo            Boolean @default(false)
  /// Controls whether the public storefront may claim an "Official Uniform
  /// Partner" relationship. A school existing in Klasiq does NOT by itself
  /// mean Klasiq is its official/exclusive supplier — the storefront shows
  /// neutral "School Uniform Collection" wording unless this is explicitly
  /// set true for a verified partnership. See docs/PHASE_3_REPORT.md
  /// "School partnership wording".
  isVerifiedPartner Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classes         SchoolClass[]
  uniformProducts Product[]                 @relation("SchoolSpecificProducts")
  assignments     SchoolUniformAssignment[]
  recommendedSets RecommendedUniformSet[]
  orders          Order[]

  @@map("schools")
}

/// A grade/class within a school (e.g. "Class 7"). Owned by the school
/// because class naming and structure differs between institutions.
model SchoolClass {
  id        String @id @default(cuid())
  schoolId  String
  name      String
  sortOrder Int    @default(0)

  school      School                    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments SchoolUniformAssignment[]
  sets        RecommendedUniformSet[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name])
  @@map("school_classes")
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

/// Top-level shopping categories that back the main nav & category routes:
/// /uniforms, /shoes, /socks, /school-bags. Self-referencing parentId keeps
/// this extensible (e.g. future "Belts & Ties" under a broader grouping)
/// without a schema change.
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  sortOrder   Int     @default(0)
  parentId    String?

  parent   Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryHierarchy")
  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("categories")
}

/// A sellable item. Most uniform products are generic (schoolId is null) and
/// reused across many schools via SchoolUniformAssignment — e.g. "White
/// Shirt". A product that only exists for one school (e.g. a school-crested
/// blazer) sets schoolId directly instead of being reused.
model Product {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  imageUrl    String?
  categoryId  String
  schoolId    String?
  isDemo      Boolean @default(false)
  isActive    Boolean @default(true)

  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  school   School?  @relation("SchoolSpecificProducts", fields: [schoolId], references: [id], onDelete: Cascade)

  variants    ProductVariant[]
  assignments SchoolUniformAssignment[]
  setItems    RecommendedUniformSetItem[]
  /// Convenience reference from historical order items. Nullable + SetNull:
  /// a deleted product must never block deleting the product itself, and
  /// must never invalidate the order — productName/skuSnapshot on OrderItem
  /// are what actually keep the historical order accurate.
  orderItems  OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([schoolId])
  @@map("products")
}

/// A purchasable size/price/stock combination of a Product. Price is
/// intentionally per-variant (not per-product) because size can affect
/// price. This is the unit referenced everywhere money or stock matters:
/// basket items, order items.
model ProductVariant {
  id                String      @id @default(cuid())
  productId         String
  size              String
  sku               String      @unique
  priceInPaise      Int
  stockQuantity     Int         @default(0)
  lowStockThreshold Int         @default(5)
  stockStatus       StockStatus @default(IN_STOCK)
  sortOrder         Int         @default(0)
  /// Lets admin retire a size (discontinued, mis-added, etc.) without
  /// deleting it — deletion is blocked anyway once an OrderItem references
  /// it (onDelete: Restrict below), so deactivation is the normal safe path.
  /// Public queries only ever return isActive: true variants.
  isActive          Boolean     @default(true)

  product              Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  basketItems          BasketItem[]
  orderItems           OrderItem[]
  inventoryAdjustments InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, size])
  @@index([productId])
  @@map("product_variants")
}

// ---------------------------------------------------------------------------
// School <-> Product relationship
// ---------------------------------------------------------------------------

/// Marks a Product as part of a school's required/available uniform for a
/// given class and gender group. classId/gender null = applies broadly
/// (all classes / all genders) at that school. This is what the school
/// storefront queries to build "the uniform collection relevant to that
/// school" without duplicating Product rows per school.
model SchoolUniformAssignment {
  id         String        @id @default(cuid())
  schoolId   String
  classId    String?
  gender     UniformGender @default(UNISEX)
  productId  String
  isRequired Boolean       @default(true)
  sortOrder  Int           @default(0)

  school  School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class   SchoolClass? @relation(fields: [classId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, classId, gender, productId])
  @@index([schoolId])
  @@map("school_uniform_assignments")
}

/// A named, curated bundle ("Class 7 Boys — Complete Uniform") that a parent
/// can add to their basket in one action. Items reference a Product (not a
/// specific size) because the correct size depends on the child; the parent
/// picks sizes when the set is added to the basket.
model RecommendedUniformSet {
  id          String        @id @default(cuid())
  schoolId    String
  classId     String?
  gender      UniformGender @default(UNISEX)
  name        String
  description String?
  isActive    Boolean       @default(true)

  school School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class  SchoolClass?                @relation(fields: [classId], references: [id], onDelete: Cascade)
  items  RecommendedUniformSetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("recommended_uniform_sets")
}

model RecommendedUniformSetItem {
  id        String @id @default(cuid())
  setId     String
  productId String
  quantity  Int    @default(1)
  sortOrder Int    @default(0)

  set     RecommendedUniformSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  product Product               @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([setId, productId])
  @@map("recommended_uniform_set_items")
}

// ---------------------------------------------------------------------------
// Basket (guest cart, cookie-identified, server-persisted)
// ---------------------------------------------------------------------------

/// A guest basket identified by an opaque id stored in an httpOnly cookie.
/// No authentication is required. Prices are always re-read from
/// ProductVariant at render/order time — nothing price-related is trusted
/// from the client.
///
/// Once a basket produces an order it flips to CONVERTED and
/// convertedOrderId is set — see docs/PHASE_2_REPORT.md. A CONVERTED basket
/// is treated as empty by every read/mutation helper; the cookie holder
/// transparently gets a fresh ACTIVE basket on their next add-to-bag.
model Basket {
  id               String       @id @default(cuid())
  status           BasketStatus @default(ACTIVE)
  convertedOrderId String?      @unique
  items            BasketItem[]
  convertedOrder   Order?       @relation(fields: [convertedOrderId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@map("baskets")
}

model BasketItem {
  id                String @id @default(cuid())
  basketId          String
  productVariantId  String
  quantity          Int    @default(1)
  /// The variant's price at the moment this line was first added — never
  /// used to compute totals (those always come from ProductVariant at
  /// checkout time), only to detect and surface a "price changed since you
  /// added this" message. Deliberately not updated when quantity changes on
  /// an existing line, so it keeps reflecting what the parent originally saw.
  priceInPaiseAtAdd Int

  basket         Basket         @relation(fields: [basketId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([basketId, productVariantId])
  @@map("basket_items")
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

/// A real, placed order. Created exactly once per successful checkout —
/// see src/server/commerce/place-order.ts for the transactional
/// create-order + decrement-stock logic and docs/PHASE_2_REPORT.md for the
/// concurrency/idempotency reasoning.
model Order {
  id             String  @id @default(cuid())
  /// Human-friendly, customer/staff-facing identifier (e.g.
  /// ORD-20260804-K7M3P). Never used for access control on its own.
  orderNumber    String  @unique
  /// Unguessable token required (alongside orderNumber) to view the public
  /// confirmation page. See "Order lookup security" in PHASE_2_REPORT.md.
  accessToken    String  @unique
  /// Client-supplied idempotency key for the checkout submission that
  /// created this order. A repeat submission with the same key returns
  /// this same order instead of creating a duplicate. Nullable only because
  /// the column must allow more than one NULL under a unique constraint in
  /// Postgres (rows can't practically exist without one in application
  /// code, but the type reflects the DB truth, not a real optionality).
  idempotencyKey String? @unique

  schoolId       String?
  customerName   String
  customerMobile String

  fulfillmentType     FulfillmentType
  deliveryAddressLine String?
  deliveryArea        String?
  deliveryLandmark    String?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(UNPAID)
  status        OrderStatus   @default(PENDING)

  subtotalInPaise    Int
  deliveryFeeInPaise Int @default(0)
  totalInPaise       Int

  school               School?               @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  items                OrderItem[]
  basket               Basket?
  /// Populated only for ORDER_CANCELLATION_RESTORE adjustments — lets an
  /// admin trace "why did this variant's stock go up" back to the specific
  /// cancelled order. See docs/PHASE_3_REPORT.md "Inventory audit trail".
  inventoryAdjustments InventoryAdjustment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId])
  @@map("orders")
}

/// Snapshots product/variant identity, name, size, SKU and price at order
/// time so a historical order stays accurate even if the underlying
/// Product/ProductVariant is later renamed, repriced, or removed.
model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  /// Nullable + SetNull: losing this reference must never affect the
  /// historical record, which lives entirely in the snapshot fields below.
  productId        String?
  productVariantId String

  productName      String
  size             String
  skuSnapshot      String
  unitPriceInPaise Int
  quantity         Int
  lineTotalInPaise Int

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

// ---------------------------------------------------------------------------
// Admin (Phase 3)
// ---------------------------------------------------------------------------

/// A shop staff account. Deliberately minimal — no roles/permissions system
/// (every admin user can do everything), no self-service signup. The first
/// account is created via a bootstrap script (see docs/PHASE_3_REPORT.md),
/// not through any public route.
model AdminUser {
  id           String  @id @default(cuid())
  name         String
  email        String  @unique
  /// scrypt hash in `salt:hash` hex form — see src/lib/admin/password.ts.
  /// Never a plaintext password, never a reversible encryption.
  passwordHash String
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions             AdminSession[]
  inventoryAdjustments InventoryAdjustment[]

  @@map("admin_users")
}

/// A server-side session. The httpOnly cookie holds a random opaque token;
/// only its SHA-256 hash is stored here, so a database read/backup leak
/// cannot be replayed as a live session cookie. See src/lib/admin/session.ts.
model AdminSession {
  id          String   @id @default(cuid())
  tokenHash   String   @unique
  adminUserId String
  expiresAt   DateTime

  createdAt DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
  @@map("admin_sessions")
}

/// Why a variant's stock quantity changed. STOCK_RECEIVED and
/// MANUAL_CORRECTION are staff-initiated from /admin/inventory;
/// ORDER_CANCELLATION_RESTORE is written automatically when an admin
/// cancels an order. Deliberately does NOT cover the customer-checkout
/// decrement — that is already fully traceable via Order/OrderItem, and
/// forcing it through this table too would mean touching the proven Phase 2
/// checkout transaction for no added traceability. See "Inventory audit
/// trail" in docs/PHASE_3_REPORT.md.
enum InventoryAdjustmentReason {
  STOCK_RECEIVED
  MANUAL_CORRECTION
  ORDER_CANCELLATION_RESTORE
}

model InventoryAdjustment {
  id               String                    @id @default(cuid())
  productVariantId String
  previousQuantity Int
  newQuantity      Int
  delta            Int
  reason           InventoryAdjustmentReason
  note             String?
  /// Null for system-restored stock where no admin session context applies
  /// (kept nullable defensively; in practice every current write path sets
  /// this because cancellation is itself an admin action).
  adminUserId      String?
  /// Set only for ORDER_CANCELLATION_RESTORE.
  orderId          String?

  createdAt DateTime @default(now())

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  adminUser      AdminUser?     @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  order          Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productVariantId])
  @@index([orderId])
  @@map("inventory_adjustments")
}
